# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Variáveis de ambiente do projeto Holtech
#
# Copie este arquivo para .env e ajuste os valores:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Modo do banco de dados:
#   0 = JSON local (sem precisar de PostgreSQL — ideal para dev/teste)
#   1 = PostgreSQL (padrão quando rodando com Docker)
TIPO_BANCO=0

# Configurações do PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=login_holtech
DB_USER=postgres
DB_PASSWORD=17212931

# HTTP/API
# Use "*" em desenvolvimento ou a URL pública em produção, por exemplo:
# CORS_ALLOWED_ORIGINS=https://testing-holtech.employer.com.br
CORS_ALLOWED_ORIGINS=*
SERVE_STATIC_FRONTEND=false
